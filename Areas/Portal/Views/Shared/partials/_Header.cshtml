@model List<SlugModel>
@{
    string _lang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var controller = ViewContext.RouteData.Values["Controller"].ToString();
    var action = ViewContext.RouteData.Values["Action"].ToString();
    var routeValues = ViewBag.LanguageTabsRouteValues != null ? (Microsoft.AspNetCore.Routing.RouteValueDictionary)ViewBag.LanguageTabsRouteValues : new Microsoft.AspNetCore.Routing.RouteValueDictionary(); ;
    routeValues.Add("culture", _lang);
}
<header id="sticky-header" class="main-header">
    <div class="container">
        <div class="row  justify-content-between align-items-end  pt-5">
            <div class="col-12 col-lg-auto text-center">
                <a asp-action="index" asp-controller="home" class="main_logo">
                    <img src="~/Portal/img/logo.png" width="130" alt="">
                </a>
                @{
                     
                    ViewData["class"] ="d-none d-md-inline d-lg-none position-absolute";
                }
                <partial name="~/Areas/Portal/Views/Shared/utilities/_languagesList.cshtml" model="@Model" />
            </div>
            <div class="col-12 col-md-auto col-lg-10">
                <div class="row flex-column align-items-end">
                    <div class="col-auto">
                        @{ ViewData["class"] = "d-none d-lg-inline"; }
                        <partial name="~/Areas/Portal/Views/Shared/utilities/_languagesList.cshtml" model="@Model" />


                    </div>
                    <div class="col-12 ">
                        <nav class="navbar navbar-expand-md main_menu  ">

                            <div class="navbar-toggler">
                                <button class="btn btn-outline-dark" type="button"
                                        data-toggle="collapse"
                                        data-target="#mainnavbar"
                                        aria-controls="mainnavbar"
                                        aria-expanded="false"
                                        aria-label="Toggle navigation">
                                    <i class="fa fa-bars"></i>
                                </button>
                                @{ 
                                    ViewData["class"] = "position-absolute";
                                }
                                <partial name="~/Areas/Portal/Views/Shared/utilities/_languagesList.cshtml" model="@Model" />

                            </div>


                            <div class="collapse navbar-collapse" id="mainnavbar">
                                <menu List-class="flip"></menu>
                            </div>
                        </nav>

                    </div>
                </div>
            </div>
        </div>
    </div>
</header>