<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="Content-Type" content="application/xhtml+html; charset=utf-8" />
    <title>@ViewData["Title"]</title>
    @RenderSection("SEO", required: false)
    <link rel="shortcut icon" href="~/Portal/img/favicon.ico" type="image/x-icon">
    <link rel="icon" href="~/Portal/img/favicon.ico" type="image/x-icon">

    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"   crossorigin="anonymous">


    @{
        var lang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;

        var styleFile = (lang == "ar") ? "style-rtl.min.css" : "style-ltr.min.css";
    }
    <link rel="stylesheet" href="~/Portal/css/@styleFile">
    @RenderSection("meta", required: false)
    @RenderSection("Styles", required: false)


</head>
<body>
    <partial name="partials/_Header.cshtml" />
    @RenderBody()
    <partial name="partials/_Footer.cshtml" />
    <script src="https://code.jquery.com/jquery-3.3.1.min.js"
            integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8="
            crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="~/Portal/js/script.min.js"></script>
    @RenderSection("footer", required: false)
</body>
</html>
