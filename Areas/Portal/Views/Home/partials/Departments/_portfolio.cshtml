

    <if include-if="@ViewBag.GalleryList != null">
        @{ 
            GalleryList galleryList = (GalleryList)ViewBag.GalleryList;
        }

        <section class="portfolio py-5" id="d-protfolio">
            <div class="container">
                <header class="col-12 text-center title-section mb-5">
                    <h1 class="fz-7">@Localizer["our_portfolio_title"] </h1>
                    <p>@ViewData["portfolio_text"]</p>
                </header>
               
                <div class="galleries-list">
                    <div class="controller">
                        @if (galleryList.Pagination.TotalPages > 1)
                        {
                             
                           <button class="btn btn-previous" 
                                    data-page="@galleryList.Pagination.PageNumber" 
                                    data-url="@Url.Action("profile","home" ,new{slug =ViewData["department"]})" 
                                    data-project="@Url.Action("project","home")" 
                                    data-total="@galleryList.Pagination.TotalPages"
                                    data-size="6">
                                <i class="fa fa-angle-left"></i>
                            </button>
                         
                            <button class="btn btn-next" 
                                    data-total="@galleryList.Pagination.TotalPages"
                                    data-page="@galleryList.Pagination.PageNumber" 
                                   data-url="@Url.Action("profile","home" ,new{slug =ViewData["department"]})" 
                                    data-project="@Url.Action("project","home")" 
                                    data-size="6">
                                <i class="fa fa-angle-right"></i>
                            </button>
                         }

                    </div>
                    <div class="profile-loader  justify-content-center align-items-center ">
                        <svg width="50px" height="50px" viewBox="0 0 128 128">
                            <g>
                                <path d="M75.4 126.63a11.43 11.43 0 0 1-2.1-22.65 40.9 40.9 0 0 0 30.5-30.6 11.4 11.4 0 1 1 22.27 4.87h.02a63.77 63.77 0 0 1-47.8 48.05v-.02a11.38 11.38 0 0 1-2.93.37z" />
                                <animateTransform attributeName="transform" type="rotate" from="0 64 64" to="360 64 64" dur="1500ms" repeatCount="indefinite"></animateTransform>
                            </g>
                        </svg>
                    </div>
                    <div class="row galleries-items">
                        @foreach (GalleryLiteDto item in galleryList.Data)
                        {
                            <div class="col-12 col-md-6 col-lg-4">
                                <figure class="gallery-item">
                                    @if (!string.IsNullOrEmpty(item.MainImage))
                                    {
                                        <img src="@item.MainImage" alt="@item.Title">
                                    }
                                    else
                                    {
                                        <img src="~/Portal/img/empty.jpg" alt="@item.Title">
                                    }

                                    <figcaption>
                                        <h2>@item.Title</h2>
                                        <a asp-action="project" asp-controller="home" asp-route-slug="@item.Slug" class="open-project">View more</a>
                                    </figcaption>
                                </figure>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </section>
    </if>