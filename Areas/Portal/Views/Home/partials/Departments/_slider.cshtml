<section class="main_slider" id="main_slider">
    <div class="main_image">
        <img src="@ViewData["image"]" />
    </div>
    <div class="container">
        <div class="row align-items-end main-area no-gutters">
            <div class="col-lg-6 col-md-8 col-12">
                <div class="intro-area ">
                    <div class="depart-title d-flex align-items-center justify-content-center">
                        <img src="@ViewData["icon"]" />
                        <h3>@ViewData["department"]</h3>
                    </div>
                    <h1>
                        <small>@ViewData["small_title"]</small>
                        @ViewData["main_title"]
                    </h1>
                    <p>
                        @ViewData["summary"]
                    </p>
                    <div class="text-center">
                        <a class="btn btn-outline-view btn-view-scroll" href="#d-protfolio">@ViewData["btn_txt"]</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>