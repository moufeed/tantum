
 @using tantum.Custom
<section class="departments-area" id="departments-area">
    <div class="container">
        <header class="departments-header mb-5 text-center">
            <h2 class="g_title text-uppercase fz-5"><strong>@Localizer["depratments"]</strong></h2>
        </header>
        <div class="row justify-content-center">
            @*Construction *@
            <div class="col-md-6 col-lg-4 depart ">
                <figure class="service-item d-flex justify-content-center align-items-center construction">
                    <div>
                        <a asp-action="@Departments.Construction" asp-controller="home">
                            <img src="~/Portal/img/departments/construction/thumb.jpg" alt="@Departments.Construction" />
                        </a>
                    </div>
                    <figcaption>
                        <div class="row no-gutters justify-content-between align-items-center">
                            <div class="col-12 col-md-auto">
                                <h3 class="text-capitalize">
                                    <a asp-action="@Departments.Construction" asp-controller="home">
                                        @Localizer[Departments.Construction]
                                    </a>
                                </h3>
                                <a asp-action="@Departments.Construction" asp-controller="home" class="arrow">
                                    <i class="fa fa-long-arrow-right"></i>
                                </a>
                            </div>
                            <div class="col-12 col-md-auto">
                                <a asp-action="@Departments.Construction" asp-controller="services">
                                    <img src="~/Portal/img/departments/construction/d-icon.png" alt="" class="icon" />
                                </a>
                            </div>
                        </div>
                    </figcaption>
                </figure>
            </div>


