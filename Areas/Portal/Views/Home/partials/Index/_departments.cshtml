 


<if include-if="ViewBag.services != null">
 
    <section class="departments-area" id="departments-area">
        <div class="container">
            <header class="departments-header mb-5 text-center">
                <h2 class="g_title text-uppercase fz-5"><strong>@Localizer["depratments"]</strong></h2>
            </header>
            <div class="row justify-content-center">

                @if (ViewBag.services.Count > 0)
                {

                    foreach (ServiceDto item in ViewBag.services)
                    {
                <div class="col-md-6 col-lg-4 depart">
                    <figure class="service-item d-flex justify-content-center align-items-center" >
                        <div>
                            <a asp-action="v" asp-controller="services" asp-route-slug="@item.Slug">
                                @if (string.IsNullOrEmpty(item.MainImage))
                                {
                                    <img src="~/Portal/img/empty.jpg" />
                                }
                                else
                                {
                                    <img src="@item.MainImage" alt="@item.Title" />
                                }
                            </a>
                        </div>
                        
                        <figcaption>
                            <div class="row no-gutters justify-content-between align-items-center">
                                <div class="col-12 col-md-auto">
                                    <h3 class="text-capitalize"><a asp-action="v" asp-controller="services" asp-route-slug="@item.Slug">@item.Title</a></h3>
                                    <a asp-action="v" asp-controller="services" class="arrow" asp-route-slug="@item.Slug">
                                        <i class="fa fa-long-arrow-right"></i>
                                    </a>
                                </div>
                                <if include-if="@item.IconVisibility">
                                    <div class="col-12 col-md-auto">
                                        <a asp-action="v" asp-controller="services" asp-route-slug="@item.Slug">
                                             <i class="icon fa @item.Icon"></i>
                                        </a>
                                    </div>
                                </if>
                            </div>
                        </figcaption>
                       
                    </figure>

                </div>


                       
                    }

                }




            </div>

           
        </div>
    </section>
</if>